<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="HiveLog">
  <description>Drupal coding standards for the HiveLog module.</description>

  <!-- Files to check. modules/ picks up every submodule (nanoprobe,
       collective, nexus) recursively — task 0137: without this, a bare
       `phpcs` (no path arguments) checked only core, and a submodule
       change could pass locally and only fail in CI, which always
       passed its own explicit path list. -->
  <file>src/</file>
  <file>tests/</file>
  <file>modules/</file>

  <!-- Module root PHP files -->
  <file>hivelog.module</file>
  <file>hivelog.install</file>

  <!-- Extensions to check — matches every file type a submodule's own
       root ships (.module, .install) plus the wider set CI already
       used (.inc, .profile, .theme), so the two can't drift again. -->
  <arg name="extensions" value="php,module,install,inc,profile,theme"/>

  <!-- Standards -->
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <!-- Line length: the project wraps at 120 (not Drupal's 80); long
       translatable strings and docblock URLs stay whole. -->
  <rule ref="Drupal.Files.LineLength">
    <properties>
      <property name="lineLimit" value="120"/>
    </properties>
  </rule>

  <!-- An entity's baseFieldDefinitions() is static, so it cannot use
       $this->t() or injected services; core's own entity classes call t()
       there too. -->
  <rule ref="DrupalPractice.Objects.GlobalFunction">
    <exclude-pattern>*/Entity/*</exclude-pattern>
  </rule>

  <!-- Tests group their methods under banner comments (a line of dashes, a title, a line of dashes)
       followed by a blank line and the next docblock; deleting the blank line
       would trip the function-spacing rule instead. -->
  <rule ref="DrupalPractice.Commenting.CommentEmptyLine">
    <exclude-pattern>*/tests/*</exclude-pattern>
  </rule>

  <!-- Exclude generated / third-party paths -->
  <exclude-pattern>vendor/</exclude-pattern>
  <exclude-pattern>node_modules/</exclude-pattern>

  <!-- PHP version -->
  <config name="php_version" value="80300"/>
</ruleset>
