<div class="overflow-x-auto">
  <table class="table w-full">
    <thead>
      <tr>
        {% for header in headers %}
          <th class="text-left">{{ header }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% if rows is empty %}
        <tr>
          <td colspan="{{ headers|length }}" class="text-center opacity-60">{{ empty_message }}</td>
        </tr>
      {% else %}
        {% for row in rows %}
          <tr>
            {% for cell in row.cells %}
              <td>{{ cell|raw }}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      {% endif %}
    </tbody>
  </table>
</div>
