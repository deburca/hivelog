{% set sortable = column_sorts is defined and column_sorts is not empty %}
<div class="overflow-x-auto">
  <table class="hivelog-entity-table table w-full{% if sortable %} hivelog-entity-table--sortable{% endif %}">
    <thead>
      <tr{% if sortable %} data-sort-label="{{ 'Sort by'|t }}"{% endif %}>
        {% for header in headers %}
          {% set column_sort = sortable ? (column_sorts[header]|default(null)) : null %}
          {% if column_sort %}
            <th class="text-left" aria-sort="{{ column_sort.direction }}">
              <a class="hivelog-entity-table__sort" href="{{ column_sort.url }}">{{ header }}<span class="hivelog-entity-table__sort-indicator" aria-hidden="true"></span></a>
            </th>
          {% elseif header == 'Operations'|t %}
            {# The Edit / Delete column's header says nothing a button does not; keep it for screen readers only. #}
            <th class="text-left"><span class="visually-hidden">{{ header }}</span></th>
          {% else %}
            <th class="text-left">{{ header }}</th>
          {% endif %}
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {% if rows is empty %}
        <tr>
          <td colspan="{{ headers|length }}" class="text-center opacity-60">{{ empty_message }}</td>
        </tr>
      {% else %}
        {% for row in rows %}
          <tr>
            {% for cell in row.cells %}
              {% set value = cell|trim %}
              {# A date on its own stays on one line instead of breaking at its hyphens; an empty cell is marked so the
                 stacked cards on a phone can leave out a label with nothing beside it. #}
              {% set cell_class = value is empty ? ' class="hivelog-entity-table__empty"' : (value|striptags|trim matches '/^\\d{4}-\\d{2}-\\d{2}$/' ? ' class="hivelog-entity-table__nowrap"' : '') %}
              {# The wrapper keeps mixed text and elements ("Unreported (" + a span + ")") together as one flex item in the card layout. #}
              <td data-label="{{ headers[loop.index0] == 'Operations'|t ? '' : headers[loop.index0] }}"{{ cell_class|raw }}>{% if value is not empty %}<span class="hivelog-entity-table__cell">{{ value|raw }}</span>{% endif %}</td>
            {% endfor %}
          </tr>
        {% endfor %}
      {% endif %}
    </tbody>
  </table>
</div>
