<div class="hivelog-error-page hivelog-error-page--{{ scene }}">
  <div class="hivelog-error-page__scene" aria-hidden="true">
    <svg class="hivelog-error-scene" viewBox="0 0 680 342" focusable="false">
      <rect class="hivelog-error-scene__sky" width="680" height="342"/>
      <rect class="hivelog-error-scene__ground" y="318" width="680" height="24"/>
      {%- if scene == 'not-found' %}
      <path class="hivelog-error-scene__trail" d="M120 250 C 150 190, 210 270, 245 215"/>
      {%- endif %}
      <rect class="hivelog-error-scene__wood-dark" x="360" y="312" width="190" height="10" rx="2"/>
      <rect class="hivelog-error-scene__box" x="372" y="262" width="166" height="50" rx="3"/>
      <rect class="hivelog-error-scene__box hivelog-error-scene__box--light" x="372" y="214" width="166" height="48" rx="3"/>
      <rect class="hivelog-error-scene__box" x="372" y="168" width="166" height="46" rx="3"/>
      <path class="hivelog-error-scene__roof" d="M358 168 L552 168 L536 142 L374 142 Z"/>
      <rect class="hivelog-error-scene__entrance" x="430" y="294" width="50" height="16" rx="2"/>
      <circle class="hivelog-error-scene__nail" cx="455" cy="268" r="2.5"/>
      {%- if scene == 'not-found' %}
      <path class="hivelog-error-scene__string" d="M455 268 L421 278 M455 268 L489 278"/>
      <rect class="hivelog-error-scene__sign" x="403" y="276" width="104" height="30" rx="3"/>
      <rect class="hivelog-error-scene__sign-stripe" x="404" y="277" width="102" height="7" rx="2"/>
      {%- else %}
      <path class="hivelog-error-scene__string" d="M455 268 L411 278 M455 268 L499 278"/>
      <rect class="hivelog-error-scene__sign" x="395" y="276" width="120" height="30" rx="3"/>
      <rect class="hivelog-error-scene__sign-stripe" x="396" y="277" width="118" height="7" rx="2"/>
      {%- endif %}
      <text class="hivelog-error-scene__sign-text" x="455" y="299" text-anchor="middle">{{ sign }}</text>
      {%- if scene == 'not-found' %}
      <g transform="translate(262 205) scale(4)">
        <ellipse class="hivelog-error-scene__wing" cx="-3" cy="-6" rx="5" ry="3"/>
        <ellipse class="hivelog-error-scene__wing" cx="2" cy="-6.5" rx="4" ry="2.6"/>
        <ellipse class="hivelog-error-scene__bee" cx="0" cy="0" rx="9" ry="6"/>
        <path class="hivelog-error-scene__stripe" d="M-2 -6V6M3 -5.5V5.5"/>
        <circle class="hivelog-error-scene__eye" cx="6" cy="-1.5" r="1.3"/>
        <path class="hivelog-error-scene__antenna" d="M7 -4Q9 -8 12 -8"/>
        <path class="hivelog-error-scene__antenna" d="M-9 0L-12 0"/>
      </g>
      <text class="hivelog-error-scene__question" x="318" y="152" text-anchor="middle">?</text>
      {%- else %}
      {%- for guard in [{x: 300, flip: 1}, {x: 610, flip: -1}] %}
      <g transform="translate({{ guard.x }} 262) scale({{ 4 * guard.flip }} 4)">
        <ellipse class="hivelog-error-scene__wing" cx="-3" cy="-6" rx="5" ry="3"/>
        <ellipse class="hivelog-error-scene__wing" cx="2" cy="-6.5" rx="4" ry="2.6"/>
        <ellipse class="hivelog-error-scene__bee" cx="0" cy="0" rx="9" ry="6"/>
        <path class="hivelog-error-scene__stripe" d="M-2 -6V6M3 -5.5V5.5"/>
        <path class="hivelog-error-scene__stinger" d="M-9 -1.4L-14 0L-9 1.4Z"/>
        <circle class="hivelog-error-scene__eye" cx="6" cy="-1.5" r="1.3"/>
        <path class="hivelog-error-scene__antenna" d="M7 -4Q8 -9 11 -10"/>
      </g>
      {%- endfor %}
      {%- endif %}
    </svg>
  </div>
  <p class="hivelog-error-page__message">{{ message }}</p>
</div>
