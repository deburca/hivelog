includes:
  - phpstan-baseline.neon

parameters:
  level: 2
  paths:
    - src/
    - tests/

  # phpstan-baseline.neon suppresses the unavoidable "unknown class Drupal\*"
  # and "unknown class Symfony\*" false positives that arise when analysing
  # a standalone module without a full Drupal project bootstrap. Real logic
  # errors in module code are still caught at level 2.
