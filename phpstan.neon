includes:
  - phpstan-baseline.neon

parameters:
  level: 2
  paths:
    - src/
    - tests/

  # All ignoreErrors patterns below suppress false positives that arise from
  # analysing a standalone Drupal module without a full project bootstrap.
  # Drupal core / Symfony classes, interfaces, and traits are not available
  # to phpstan without the Drupal autoloader. Real errors in module-owned
  # logic are still reported at level 2.
  ignoreErrors:
    - '#unknown class#'
    - '#unknown interface#'
    - '#unknown trait#'
    - '#invalid type#'
    - '#invalid return type#'
    - '#does not extend any class#'
    - '#Unsafe usage of new static\(\)#'
    - '#Access to an undefined property#'
    - '#Call to an undefined method#'
    - '#not found#'
