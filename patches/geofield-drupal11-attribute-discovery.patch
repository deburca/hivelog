+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\geofield\Attribute;
+
+use Drupal\Component\Plugin\Attribute\Plugin;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+
+/**
+ * Defines a GeofieldProximitySource attribute.
+ *
+ * @see \Drupal\geofield\Plugin\GeofieldProximitySourceManager
+ * @see plugin_api
+ */
+#[\Attribute(\Attribute::TARGET_CLASS)]
+class GeofieldProximitySource extends Plugin {
+
+  /**
+   * Constructs a GeofieldProximitySource attribute.
+   *
+   * @param string $id
+   *   The plugin ID.
+   * @param \Drupal\Core\StringTranslation\TranslatableMarkup $label
+   *   The label of the plugin.
+   * @param \Drupal\Core\StringTranslation\TranslatableMarkup $description
+   *   A short description of the plugin.
+   * @param \Drupal\Core\StringTranslation\TranslatableMarkup|null $exposedDescription
+   *   (optional) A description to show in the exposed form.
+   * @param array $context
+   *   (optional) An array of the view handler plugins type (contexts) it
+   *   would work for. Possible values: 'filter', 'sort', 'field'.
+   * @param bool $exposedOnly
+   *   (optional) Whether the plugin should work only if exposed filter.
+   * @param string|null $deriver
+   *   (optional) The deriver class.
+   */
+  public function __construct(
+    public readonly string $id,
+    public readonly TranslatableMarkup $label = new TranslatableMarkup(''),
+    public readonly TranslatableMarkup $description = new TranslatableMarkup(''),
+    public readonly ?TranslatableMarkup $exposedDescription = NULL,
+    public readonly array $context = [],
+    public readonly bool $exposedOnly = FALSE,
+    public readonly ?string $deriver = NULL,
+  ) {}
+
+}
