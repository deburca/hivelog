{
    "name": "hivelog/hivelog",
    "description": "Drupal 11 module – beekeeping activity logger for managing apiaries, hives, inspections, queens, and queen observations.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/deburca/hivelog",
    "authors": [
        {
            "name": "Paddy de Búrca",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.3",
        "drupal/core": "^11",
        "drupal/geofield": "^10.3",
        "drupal/leaflet": "^10"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "drupal": {
            "module-name": "hivelog"
        },
        "patches": {
            "drupal/geofield": {
                "Convert geofield plugins to PHP attributes for Drupal 11": "web/modules/contrib/hivelog/patches/geofield-drupal11-attribute-discovery.patch",
                "Update geofield validation constraint metadata for Drupal 11": "web/modules/contrib/hivelog/patches/geofield-validator-compatibility.patch"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
