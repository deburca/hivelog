#: modules/contrib/hivelog/hivelog.module:51
msgid "Central Beehive Registration (CBR) number"
msgstr "Centralt bigårdsregister (CBR)-nummer"
#: modules/contrib/hivelog/hivelog.module:52
msgid "Your national/central beehive registration number, if any."
msgstr "Dit nationale/centrale bigårdsregistreringsnummer, hvis du har et."
#: modules/contrib/hivelog/hivelog.install:153
msgid "Replaced latitude/longitude fields with geolocation field on apiaries."
msgstr "Erstattede breddegrad-/længdegradsfelter med et geolokationsfelt på bigårde."
#: modules/contrib/hivelog/hivelog.install:217
msgid "Migrated apiary geolocation field from geolocation module to geofield module."
msgstr "Migrerede bigårdens geolokationsfelt fra geolocation-modulet til geofield-modulet."
#: modules/contrib/hivelog/hivelog.install:240
msgid "Added external check field to hive inspections."
msgstr "Tilføjede feltet for udvendig kontrol til stadeeftersyn."
#: modules/contrib/hivelog/hivelog.install:263
msgid "Added weight field to hive inspections."
msgstr "Tilføjede vægtfelt til stadeeftersyn."
#: modules/contrib/hivelog/hivelog.install:286
msgid "Added images field to hives."
msgstr "Tilføjede billedfelt til bistader."
#: modules/contrib/hivelog/hivelog.install:309
msgid "Added images field to hive inspections."
msgstr "Tilføjede billedfelt til stadeeftersyn."
#: modules/contrib/hivelog/hivelog.install:329
msgid "Retired dormant queen_brood field on hive inspections."
msgstr "Fjernede det ubrugte queen_brood-felt på stadeeftersyn."
#: modules/contrib/hivelog/hivelog.install:360
msgid "Installed the Queen entity type and removed queen_year/queen_colour from hives."
msgstr "Installerede entitetstypen Dronning og fjernede queen_year/queen_colour fra bistader."
#: modules/contrib/hivelog/hivelog.install:379
msgid "Installed the Queen Observation entity type."
msgstr "Installerede entitetstypen Dronningobservation."
#: modules/contrib/hivelog/hivelog.install:394
msgid "CBR field already installed; nothing to do."
msgstr "CBR-feltet er allerede installeret; intet at gøre."
#: modules/contrib/hivelog/hivelog.install:408
msgid "Added CBR number field to user accounts."
msgstr "Tilføjede CBR-nummerfelt til brugerkonti."
#: modules/contrib/hivelog/hivelog.install:445
msgid "Re-synced apiary.geolocation stored field storage definition."
msgstr "Gensynkroniserede den lagrede feltdefinition for apiary.geolocation."
#: modules/contrib/hivelog/hivelog.install:494
msgid "Migrated hivelog permissions to own/any variants for roles: @roles."
msgstr "Migrerede hivelog-tilladelser til egne/alle-varianter for rollerne: @roles."
#: modules/contrib/hivelog/hivelog.install:498
msgid "No roles had old hivelog permissions to migrate."
msgstr "Ingen roller havde gamle hivelog-tilladelser at migrere."
#: modules/contrib/hivelog/hivelog.install:533
msgid "Installed beekeepers and visibility fields on the Apiary entity."
msgstr "Installerede felterne biavlere og synlighed på bigårds-entiteten."
#: modules/contrib/hivelog/hivelog.install:554
msgid "Installed the Calendar Action entity type."
msgstr "Installerede entitetstypen Kalenderhandling."
#: modules/contrib/hivelog/hivelog.install:576
msgid "Installed the Hive Action Log entity type."
msgstr "Installerede entitetstypen Stade-handlingslog."
#: modules/contrib/hivelog/hivelog.install:610
msgid "Installed the inspection field on the Hive Action Log entity."
msgstr "Installerede eftersynsfeltet på Stade-handlingslog-entiteten."
#: modules/contrib/hivelog/hivelog.install:644
msgid "Installed the scope field on the Calendar Action entity."
msgstr "Installerede omfangsfeltet på Kalenderhandling-entiteten."
#: modules/contrib/hivelog/hivelog.install:665
msgid "Installed the Apiary Action Log entity type."
msgstr "Installerede entitetstypen Bigårds-handlingslog."
#: modules/contrib/hivelog/hivelog.install:688
msgid "Removed the bee_breed field from hives; breed is now tracked on the queen."
msgstr "Fjernede bee_breed-feltet fra bistader; race registreres nu på dronningen."
#: modules/contrib/hivelog/hivelog.install:715
msgid "Installed the Inventory Item and Inventory Purchase entity types."
msgstr "Installerede entitetstyperne Lagervare og Lagerindkøb."
#: modules/contrib/hivelog/hivelog.install:736
msgid "Installed the Calendar Action Item Requirement entity type."
msgstr "Installerede entitetstypen Kalenderhandlings vareforbrug."
#: modules/contrib/hivelog/hivelog.install:758
msgid "Installed the Inventory Usage entity type."
msgstr "Installerede entitetstypen Lagerforbrug."
#: modules/contrib/hivelog/hivelog.install:778
msgid "Installed the Product entity type."
msgstr "Installerede entitetstypen Produkt."
#: modules/contrib/hivelog/hivelog.install:799
msgid "Installed the Calendar Action Product Yield entity type."
msgstr "Installerede entitetstypen Kalenderhandlings produktudbytte."
#: modules/contrib/hivelog/hivelog.install:820
msgid "Installed the Harvest Yield entity type."
msgstr "Installerede entitetstypen Høstudbytte."
#: modules/contrib/hivelog/hivelog.install:846
msgid "Installed the low_stock_threshold field storage on Inventory Item."
msgstr "Installerede feltlageret low_stock_threshold på Lagervare."
#: modules/contrib/hivelog/hivelog.install:874
msgid "Installed the disposal_date/disposal_reason field storage on Inventory Purchase."
msgstr "Installerede feltlageret disposal_date/disposal_reason på Lagerindkøb."
#: modules/contrib/hivelog/hivelog.install:61
msgid "Could not delete @type entities during uninstall: @message"
msgstr "Kunne ikke slette @type-entiteter under afinstallation: @message"
#: modules/contrib/hivelog/hivelog.install:930
msgid "Cleaned up cbr_number field tracking directly during uninstall."
msgstr "Ryddede op i sporingen af cbr_number-feltet direkte under afinstallation."
