/**
 * Removes the now-duplicate bee_breed field from hives.
 *
 * Breed is a property of the queen, not the hive: a Buckfast queen can be
 * introduced into any hive, and a hive keeps its breed identity from
 * whichever queen currently occupies it. Queen::breed has always mirrored
 * this field with an identical allowed-value list; hive breed is now
 * resolved via Hive::getActiveQueen() instead. The module is not yet in
 * production, so no data migration is required (same rationale as
 * hivelog_update_10008, which split queen tracking off the hive).
 */
function hivelog_update_10019(&$sandbox) {
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  $bee_breed_definition = $entity_definition_update_manager
    ->getFieldStorageDefinition('bee_breed', 'hive');
  if ($bee_breed_definition) {
    $entity_definition_update_manager->uninstallFieldStorageDefinition($bee_breed_definition);
  }

  return t('Removed the bee_breed field from hives; breed is now tracked on the queen.');
}

/**
 * Installs the Inventory Item and Inventory Purchase entity types.
 *
 * First half of the inventory tracking project (docs/project-management/
 * decisions/0027-inventory-tracking-and-depreciation.md): InventoryItem is
 * the per-apiary catalog of consumable/durable items; InventoryPurchase is
 * the acquisition ledger (amount bought, unit price) that stock levels and
 * durable-item depreciation are both computed from. The module is not yet
 * in production, so no data migration is required.
 */
function hivelog_update_10020(&$sandbox) {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  if (!$entity_definition_update_manager->getEntityType('inventory_item')) {
    $inventory_item_type = $entity_type_manager->getDefinition('inventory_item');
    $entity_definition_update_manager->installEntityType($inventory_item_type);
  }

  if (!$entity_definition_update_manager->getEntityType('inventory_purchase')) {
    $inventory_purchase_type = $entity_type_manager->getDefinition('inventory_purchase');
    $entity_definition_update_manager->installEntityType($inventory_purchase_type);
  }

  return t('Installed the Inventory Item and Inventory Purchase entity types.');
}

/**
 * Installs the Calendar Action Item Requirement entity type.
 *
 * The "recipe" half of inventory tracking (docs/project-management/
 * decisions/0027-inventory-tracking-and-depreciation.md): links a
 * CalendarAction to the InventoryItems (and quantities) it typically
 * requires. The module is not yet in production, so no data migration is
 * required.
 */
function hivelog_update_10021(&$sandbox) {
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_definition_update_manager = \Drupal::entityDefinitionUpdateManager();

  if (!$entity_definition_update_manager->getEntityType('calendar_action_item_requirement')) {
    $requirement_type = $entity_type_manager->getDefinition('calendar_action_item_requirement');
    $entity_definition_update_manager->installEntityType($requirement_type);
  }

  return t('Installed the Calendar Action Item Requirement entity type.');
}

/**
 * Removes all traces of the cbr_number field from Drupal's tracking stores.
 *
 * The normal EntityDefinitionUpdateManager::uninstallFieldStorageDefinition()
 * path internally calls countFieldData(), which queries the column. If the
 * column has already been removed (e.g. after a database restore), the query
 * throws a fatal PDO exception. To avoid this, we bypass the update manager
 * entirely and directly scrub every key-value store that references the field.
 *
 * When the column DOES exist we still try the clean uninstall path first so
 * that Drupal can drop the column itself.
 */
function _hivelog_cleanup_cbr_field($entity_definition_update_manager) {
  $schema = \Drupal::database()->schema();
  $column_exists = $schema->fieldExists('users_field_data', 'cbr_number');

  // Happy path: column exists, use the proper API to drop it.
  if ($column_exists) {
    try {
      $cbr_definition = $entity_definition_update_manager
        ->getFieldStorageDefinition('cbr_number', 'user');
      if ($cbr_definition) {
        $entity_definition_update_manager->uninstallFieldStorageDefinition($cbr_definition);
        return;
      }
    }
    catch (\Exception $e) {
      // Fall through to manual cleanup below.
    }
  }

  // Manual cleanup: use the EntityLastInstalledSchemaRepository service so
  // that BOTH the in-memory cache AND the key-value store are updated in
  // one step. Writing to the key-value store directly does not clear the
  // service's PHP-level cache, which is why earlier attempts still failed.
  /** @var \Drupal\Core\Entity\EntityLastInstalledSchemaRepositoryInterface $schema_repo */
  $schema_repo = \Drupal::service('entity.last_installed_schema.repository');
  $installed = $schema_repo->getLastInstalledFieldStorageDefinitions('user');
  if (isset($installed['cbr_number'])) {
    $schema_repo->deleteLastInstalledFieldStorageDefinition($installed['cbr_number']);
  }

  // Remove the SQL schema tracking for the field.
  $schema_kv = \Drupal::keyValue('entity.storage_schema.sql');
  $schema_kv->delete('user.field_schema_data.cbr_number');

  // Drop the column directly if it somehow still exists.
  foreach (['users_field_data', 'users'] as $table) {
    if ($schema->fieldExists($table, 'cbr_number')) {
      $schema->dropField($table, 'cbr_number');
    }
  }

  \Drupal::logger('hivelog')->notice('Cleaned up cbr_number field tracking directly during uninstall.');
}
