<?php

/**
 * @file
 * Hook implementations for the Nexus module.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Url;
use Drupal\hivelog\Delete\HivelogDeleteDependencyRegistry;
use Drupal\hivelog\Entity\Apiary;
use Drupal\hivelog\Entity\Hive;

/**
 * Implements hook_cron().
 *
 * Runs the full in-process AI synthesis cycle — see
 * NexusInsightGenerator (task 0103) and
 * docs/project-management/decisions/0100-nexus-in-process-ai-synthesis.md.
 */
function nexus_cron() {
  \Drupal::service('nexus.insight_generator')->generateAll();
}

/**
 * Implements hook_hivelog_apiary_view_panels().
 *
 * The apiary-scoped "AI Insight" panel stays on the main Apiary
 * canonical page — only the hive-scoped one moved to the dedicated
 * Insights page (task 0111); the user's own decluttering request named
 * `/hivelog/hive/{hive}` specifically, and Apiary hasn't grown the same
 * "too busy" problem (yet).
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 */
function nexus_hivelog_apiary_view_panels(Apiary $apiary) {
  return \Drupal::service('nexus.hive_insight_panel_builder')->buildApiaryPanel($apiary);
}

/**
 * Implements hook_hivelog_hive_insights_panels().
 *
 * Moved here from hook_hivelog_hive_view_panels() (task 0111) — the
 * panel's own content/logic (`buildHivePanel()`) is unchanged, only
 * which page it renders on.
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 */
function nexus_hivelog_hive_insights_panels(Hive $hive) {
  return \Drupal::service('nexus.hive_insight_panel_builder')->buildHivePanel($hive);
}

/**
 * Implements hook_hivelog_hive_stat_tiles().
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 */
function nexus_hivelog_hive_stat_tiles(Hive $hive) {
  return \Drupal::service('nexus.hive_insight_panel_builder')->buildHiveStatTile($hive);
}

/**
 * Implements hook_hivelog_apiary_stat_tiles().
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 */
function nexus_hivelog_apiary_stat_tiles(Apiary $apiary) {
  return \Drupal::service('nexus.hive_insight_panel_builder')->buildApiaryStatTile($apiary);
}

/**
 * Implements hook_hivelog_needs_attention_alerts().
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 */
function nexus_hivelog_needs_attention_alerts(array $apiaries, CacheableMetadata $cache) {
  return \Drupal::service('nexus.provider_health_alert_collector')->collectAlerts($apiaries, $cache);
}

/**
 * Implements hook_hivelog_dashboard_sections().
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 */
function nexus_hivelog_dashboard_sections(array $apiaries, CacheableMetadata $cache) {
  return \Drupal::service('nexus.dashboard_ai_insights_builder')->build($apiaries, $cache);
}

/**
 * Implements hook_hivelog_app_nav_items().
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 * `group: setup` (task 0120) — a one-off, admin-provisioned integration,
 * not a day-to-day record-keeping or inventory destination.
 */
function nexus_hivelog_app_nav_items() {
  return [
    'nexus_ai_provider_configs' => [
      'title' => t('AI Provider Configs'),
      'url' => Url::fromRoute('entity.ai_provider_config.collection'),
      'weight' => 9,
      'group' => 'setup',
      'section' => 'ai_provider_config',
    ],
  ];
}

/**
 * Implements hook_hivelog_delete_dependencies().
 *
 * ADR-0103 rows #8 and #13 — the two hive_insight rows `hivelog` core
 * can't declare itself, since it doesn't depend on this module. Neither
 * has a management link: HiveInsight has no UI of its own (it's
 * derived, read-only data), and CASCADE doesn't need one anyway. See
 * hivelog.api.php.
 */
function nexus_hivelog_delete_dependencies() {
  return [
    [
      'adr_row' => '8',
      'parent' => 'apiary',
      'child' => 'hive_insight',
      'field' => 'apiary',
      'treatment' => HivelogDeleteDependencyRegistry::CASCADE,
      'manage' => NULL,
    ],
    [
      'adr_row' => '13',
      'parent' => 'hive',
      'child' => 'hive_insight',
      'field' => 'hive',
      'treatment' => HivelogDeleteDependencyRegistry::CASCADE,
      'manage' => NULL,
    ],
  ];
}
