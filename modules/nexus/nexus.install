<?php

/**
 * @file
 * Install, update and uninstall functions for the Nexus module.
 */

use Drupal\user\Entity\Role;

/**
 * Revokes `edit own`/`delete own ai provider config` from every role.
 *
 * Task 0135 — mirrors `collective_update_10001()` exactly, for the same
 * reason: with `AiProviderConfig` create access staying
 * `administer hivelog`-only, the entity's owner is always an admin
 * already covered by `edit any`/`delete any ai provider config`, so
 * neither "own" permission was ever reachable through the UI.
 */
function nexus_update_10001(&$sandbox) {
  $permissions = ['edit own ai provider config', 'delete own ai provider config'];
  foreach (Role::loadMultiple() as $role) {
    user_role_revoke_permissions($role->id(), $permissions);
  }

  return t('Revoked the removed edit own/delete own ai provider config permissions from every role.');
}

/**
 * Implements hook_uninstall().
 *
 * Deletes all nexus entities in child-first order (insights before the
 * provider config), wrapped in a try/catch so uninstall succeeds even
 * when the underlying database tables have already been removed.
 * HiveInsight/AiProviderConfig entity types are installed automatically
 * by Drupal when this module is first enabled (no hook_install()
 * needed), so only cleanup is required here.
 */
function nexus_uninstall() {
  $entity_type_manager = \Drupal::entityTypeManager();

  $entity_type_ids = [
    'hive_insight',
    'ai_provider_config',
  ];

  foreach ($entity_type_ids as $entity_type_id) {
    try {
      $storage = $entity_type_manager->getStorage($entity_type_id);
      // Delete entities in batches to avoid memory issues on large datasets.
      while ($ids = $storage->getQuery()->accessCheck(FALSE)->range(0, 50)->execute()) {
        $entities = $storage->loadMultiple($ids);
        $storage->delete($entities);
      }
    }
    catch (\Exception $e) {
      // The table may already be gone — log and continue.
      \Drupal::logger('nexus')->notice(
        'Could not delete @type entities during uninstall: @message',
        ['@type' => $entity_type_id, '@message' => $e->getMessage()]
      );
    }
  }
}
