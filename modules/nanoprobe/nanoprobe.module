<?php

/**
 * @file
 * Hook implementations for the Nanoprobe module.
 */

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Url;
use Drupal\hivelog\Delete\HivelogDeleteDependencyRegistry;
use Drupal\hivelog\Entity\Apiary;
use Drupal\hivelog\Entity\Hive;

/**
 * Implements hook_hivelog_apiary_view_panels().
 *
 * The apiary-scoped Sensors panel stays on the main Apiary canonical
 * page — only the hive-scoped one moved to the dedicated Insights page
 * (task 0111); see nexus_hivelog_apiary_view_panels()'s own docblock
 * for why apiary is unaffected.
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 */
function nanoprobe_hivelog_apiary_view_panels(Apiary $apiary) {
  return \Drupal::service('nanoprobe.sensor_panel_builder')->buildApiaryPanel($apiary);
}

/**
 * Implements hook_hivelog_hive_insights_panels().
 *
 * Moved here from hook_hivelog_hive_view_panels() (task 0111) — the
 * panel's own content/logic (`buildHivePanel()`) is unchanged, only
 * which page it renders on.
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 */
function nanoprobe_hivelog_hive_insights_panels(Hive $hive) {
  return \Drupal::service('nanoprobe.sensor_panel_builder')->buildHivePanel($hive);
}

/**
 * Implements hook_hivelog_hive_stat_tiles().
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 */
function nanoprobe_hivelog_hive_stat_tiles(Hive $hive) {
  return \Drupal::service('nanoprobe.sensor_panel_builder')->buildHiveStatTiles($hive);
}

/**
 * Implements hook_hivelog_apiary_stat_tiles().
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 */
function nanoprobe_hivelog_apiary_stat_tiles(Apiary $apiary) {
  return \Drupal::service('nanoprobe.sensor_panel_builder')->buildApiaryStatTiles($apiary);
}

/**
 * Implements hook_hivelog_needs_attention_alerts().
 *
 * See hivelog.api.php and
 * docs/project-management/decisions/0099-submodule-canonical-page-panel-hook.md.
 */
function nanoprobe_hivelog_needs_attention_alerts(array $apiaries, CacheableMetadata $cache) {
  return \Drupal::service('nanoprobe.sensor_alert_collector')->collectAlerts($apiaries, $cache);
}

/**
 * Implements hook_hivelog_app_nav_items().
 *
 * See hivelog.api.php and [[0105-submodule-navigation-menu-links]] — the
 * `nanoprobe.links.menu.yml` entry alongside this one is a best-effort
 * secondary integration for themes that do render menu-link children;
 * this hook is the one hivelog core's own in-app nav actually uses.
 */
function nanoprobe_hivelog_app_nav_items() {
  return [
    'nanoprobe_sensor_devices' => [
      'title' => t('Sensor Devices'),
      'url' => Url::fromRoute('entity.sensor_device.collection'),
      'weight' => 10,
    ],
  ];
}

/**
 * Implements hook_cron().
 *
 * Computes/updates daily rollups, then purges raw readings past the
 * retention window — see SensorReadingRetentionService (task 0082).
 */
function nanoprobe_cron() {
  \Drupal::service('nanoprobe.sensor_reading_retention')->runDailyMaintenance();
}

/**
 * Implements hook_hivelog_delete_dependencies().
 *
 * ADR-0103 rows #7, #12, #27 and #28 — the four sensor_device rows
 * `hivelog` core can't declare itself, since it doesn't depend on this
 * module. See hivelog.api.php.
 */
function nanoprobe_hivelog_delete_dependencies() {
  return [
    [
      'adr_row' => '7',
      'parent' => 'apiary',
      'child' => 'sensor_device',
      'field' => 'apiary',
      'treatment' => HivelogDeleteDependencyRegistry::BLOCK,
      'manage' => 'parent-canonical#sensors',
    ],
    [
      'adr_row' => '12',
      'parent' => 'hive',
      'child' => 'sensor_device',
      'field' => 'hive',
      'treatment' => HivelogDeleteDependencyRegistry::DETACH,
      'manage' => 'parent-canonical',
    ],
    [
      'adr_row' => '27',
      'parent' => 'sensor_device',
      'child' => 'sensor_reading',
      'field' => 'sensor_device',
      'treatment' => HivelogDeleteDependencyRegistry::CASCADE,
      'manage' => NULL,
    ],
    [
      'adr_row' => '28',
      'parent' => 'sensor_device',
      'child' => 'sensor_reading_daily',
      'field' => 'sensor_device',
      'treatment' => HivelogDeleteDependencyRegistry::CASCADE,
      'manage' => NULL,
    ],
  ];
}
