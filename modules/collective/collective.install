<?php

/**
 * @file
 * Install, update and uninstall functions for the Collective module.
 */

use Drupal\user\Entity\Role;

/**
 * Revokes `edit own`/`delete own api client` from every role (task 0135).
 *
 * Both permissions are removed from `collective.permissions.yml` in the
 * same commit — with `ApiClient` create access staying
 * `administer hivelog`-only, the entity's owner is always an admin
 * already covered by `edit any`/`delete any api client`, so neither
 * permission was ever reachable through the UI. `user_role_revoke_permissions()`
 * is a no-op for a role that doesn't have the permission, so this is
 * safe to run unconditionally against every role.
 */
function collective_update_10001(&$sandbox) {
  $permissions = ['edit own api client', 'delete own api client'];
  foreach (Role::loadMultiple() as $role) {
    user_role_revoke_permissions($role->id(), $permissions);
  }

  return t('Revoked the removed edit own/delete own api client permissions from every role.');
}

/**
 * Implements hook_uninstall().
 *
 * Deletes all collective entities, wrapped in a try/catch so uninstall
 * succeeds even when the underlying database tables have already been
 * removed. The `ApiClient` entity type is installed automatically by
 * Drupal when this module is first enabled (no hook_install() needed),
 * so only cleanup is required here. `HiveInsight` moved to `nexus` in
 * task 0102 — its cleanup lives in that module's own uninstall hook now.
 */
function collective_uninstall() {
  $entity_type_manager = \Drupal::entityTypeManager();

  $entity_type_ids = [
    'api_client',
  ];

  foreach ($entity_type_ids as $entity_type_id) {
    try {
      $storage = $entity_type_manager->getStorage($entity_type_id);
      // Delete entities in batches to avoid memory issues on large datasets.
      while ($ids = $storage->getQuery()->accessCheck(FALSE)->range(0, 50)->execute()) {
        $entities = $storage->loadMultiple($ids);
        $storage->delete($entities);
      }
    }
    catch (\Exception $e) {
      // The table may already be gone — log and continue.
      \Drupal::logger('collective')->notice(
        'Could not delete @type entities during uninstall: @message',
        ['@type' => $entity_type_id, '@message' => $e->getMessage()]
      );
    }
  }
}
