<?php

/**
 * @file
 * The HiveLog API module.
 *
 * Mostly services and routes: a path processor serves core JSON:API under
 * /hivelog/api/v1 for an allow-list of resources (see HivelogApiResources).
 */

use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\hivelog_api\HivelogApiResources;
use Drupal\user\Entity\Role;

/**
 * Implements hook_query_alter().
 *
 * Narrows an access-checked entity query for an exposed type to the records
 * the current user may view, on the versioned API only. See
 * HivelogApiQueryAccess for why JSON:API needs this.
 */
function hivelog_api_query_alter(AlterableInterface $query) {
  \Drupal::service('hivelog_api.query_access')->alter($query);
}

/**
 * Implements hook_jsonapi_entity_filter_access().
 *
 * Lets the versioned API filter by the exposed types' fields; see
 * HivelogApiQueryAccess::filterAccess() for why and for what makes it safe.
 */
function hivelog_api_jsonapi_entity_filter_access(EntityTypeInterface $entity_type, AccountInterface $account) {
  return \Drupal::service('hivelog_api.query_access')->filterAccess($entity_type);
}

/**
 * Implements hook_modules_installed().
 *
 * The field-app role holds the sensor view permissions only when `nanoprobe`
 * defines them. If that module is installed after this one, grant them then,
 * so the app's hive tiles work without a second step. Not during a
 * configuration import, which brings its own role.
 */
function hivelog_api_modules_installed(array $modules, bool $is_syncing) {
  if ($is_syncing || !in_array('nanoprobe', $modules, TRUE)) {
    return;
  }
  \Drupal::moduleHandler()->loadInclude('hivelog_api', 'install');
  if (Role::load(HivelogApiResources::SCOPE)) {
    hivelog_api_sync_field_app_role();
  }
}
