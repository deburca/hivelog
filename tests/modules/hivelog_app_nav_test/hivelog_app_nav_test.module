<?php

/**
 * @file
 * Registers the test-only nav items tasks 0146/0150's kernel tests use.
 *
 * Not part of the distributed module — see hivelog_app_nav_test.info.yml.
 * Both point at a real existing route (the apiary/hive collection)
 * rather than defining a route of their own, so the tests can control
 * accessibility with ordinary permission grants instead of test-only
 * plumbing.
 */

use Drupal\Core\Url;

/**
 * Implements hook_hivelog_app_nav_items().
 */
function hivelog_app_nav_test_hivelog_app_nav_items() {
  return [
    'hivelog_app_nav_test_widget' => [
      'title' => t('Test Widgets'),
      'url' => Url::fromRoute('entity.apiary.collection'),
      'weight' => 50,
      'group' => 'insights',
      'parent' => 'insights',
    ],
    // A `parent` naming nothing that exists at all (task 0150) — the
    // "typo" half of the fallback-to-top-level case; the other half
    // (a parent that exists but isn't itself accessible/derivable) is
    // already covered by the real registry whenever a submodule isn't
    // installed.
    'hivelog_app_nav_test_orphan' => [
      'title' => t('Test Orphan'),
      'url' => Url::fromRoute('entity.hive.collection'),
      'weight' => 51,
      'group' => 'insights',
      'parent' => 'nonexistent_hub',
    ],
  ];
}
